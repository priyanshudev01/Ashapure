generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  MERCHANT
  DELIVERY
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  fullName       String
  role           UserRole
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  customerOrders Order[]        @relation("CustomerOrders")
  merchantOrders Order[]        @relation("MerchantOrders")
  deliveryOrders Order[]        @relation("DeliveryOrders")
  products       Product[]      @relation("MerchantProducts")
  payments       PaymentRecord[]
}

model Product {
  id         String      @id @default(uuid())
  merchantId String?
  merchant   User?       @relation("MerchantProducts", fields: [merchantId], references: [id])
  name       String
  description String?
  category   String?
  price      Decimal     @db.Decimal(10, 2)
  unit       String
  stock      Int         @default(0)
  imageUrl   String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
}

model Order {
  id           String      @id @default(uuid())
  customerId   String
  customer     User        @relation("CustomerOrders", fields: [customerId], references: [id])
  merchantId   String?
  merchant     User?       @relation("MerchantOrders", fields: [merchantId], references: [id])
  deliveryId   String?
  delivery     User?       @relation("DeliveryOrders", fields: [deliveryId], references: [id])
  status       OrderStatus @default(PENDING)
  subtotal     Decimal     @db.Decimal(10, 2)
  deliveryFee  Decimal     @db.Decimal(10, 2)
  discount     Decimal     @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  deliverySlot String?
  address      String?
  verificationPassed Boolean?
  verificationNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  payments     PaymentRecord[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)
}

model PaymentRecord {
  id         String        @id @default(uuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   User          @relation(fields: [customerId], references: [id])
  amount     Decimal       @db.Decimal(10, 2)
  method     String?
  status     PaymentStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}
